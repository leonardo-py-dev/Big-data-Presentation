# Copie para .env e preencha. Nunca commite o .env.
# Banco da coleta (Atlas)
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/pesquisa_redes_sociais?retryWrites=true&w=majority
# Banco SEPARADO para dados sintéticos de teste (mesmo cluster, outro banco)
MONGODB_URI_TEST=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/pesquisa_redes_sociais_test?retryWrites=true&w=majority
# Porta da API
PORT=3001
# Origem do frontend (CORS allowlist — sem "*" em produção)
CLIENT_ORIGIN=http://localhost:5173
# Segredo de assinatura do JWT (mín. 32 caracteres aleatórios — nunca commite)
JWT_SECRET=troque-por-96-caracteres-hex-aleatorios
# true em produção cross-site (front e API em domínios diferentes); false no dev local
COOKIE_SECURE=false
# Admin inicial (criado via: npm run seed --workspace=@pesquisa/server)
ADMIN_EMAIL=voce@example.com
ADMIN_PASSWORD=troque-por-senha-forte-com-12-caracteres-ou-mais
